FROM pgvector/pgvector@sha256:42e7f6b4e1eceb02ff14e3e6bc6108bbe259abbe83879dc1845d0da1ddeb555d
# The pgvector release image embeds PostgreSQL 18.4; keep the source's 18.6 patch level.
RUN apt-get -o Dir::Etc::sourcelist=sources.list.d/pgdg.list -o Dir::Etc::sourceparts=- -o Acquire::http::Timeout=30 update && apt-get install -y --no-install-recommends \
    postgresql-18=18.6-1.pgdg12+2 postgresql-client-18=18.6-1.pgdg12+2 \
    && rm -rf /var/lib/apt/lists/*
